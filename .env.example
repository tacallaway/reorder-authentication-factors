# Okta issuer URL — e.g., https://your-org.okta.com/oauth2/default
VITE_OKTA_ISSUER=

# Client ID from your Okta SPA app integration
VITE_OKTA_CLIENT_ID=

# Redirect URI registered in the Okta app — e.g., http://localhost:5173/login/callback
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback
